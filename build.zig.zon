.{
    .name = .plugins,
    .version = "0.1.0",
    // Zig 0.17 requires a fingerprint and derives it from the package name; if
    // you rename the package, take the value the compiler suggests.
    .fingerprint = 0xec85f671c93120bb,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // The shared plugin SDK every plugin imports as `lovelycarve`.
        .lovelycarve = .{ .path = "zig-sdk" },
        // Windows registry hive (REGF) reader.
        .regf_zig = .{ .path = "libs/regf.zig" },
        // Windows INI reader for application config files.
        .ini_zig = .{ .path = "libs/ini.zig" },
        // Android binary XML (AXML) reader, extracted from apkanalyzer.
        .axml_zig = .{ .path = "libs/axml.zig" },
        // Ciphers and hashes (RC4, DES, AES modes, Blowfish, SHA-2).
        .zig_cryptobin = .{ .path = "libs/zig-cryptobin" },
        // SQLite wrapper (bundles the amalgamation) for read-only evidence
        // databases; introduced for the Android system analyzer.
        .zqlite = .{ .path = "libs/zqlite.zig" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "scripts",
    },
}
